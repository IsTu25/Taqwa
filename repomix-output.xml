export default function RozaScreen() {
  const [fastingChecklist, setFastingChecklist] = useState({
    suhoor: false,
    fajr: false,
    dhuhr: false,
    asr: false,
    iftar: false,
    maghrib: false,
    isha: false,
    taraweeh: false,
