    paddingHorizontal: 15, marginBottom: 16, height: 54,
  },
  inputIcon: { marginRight: 10 },
  input: { flex: 1, color: '#FFFFFF', fontSize: 16 },
  errorText: { color: '#FF4444', marginBottom: 12, textAlign: 'center' },
